<?xml version="1.0" encoding="utf-8"?>
<!-- Creamos el layout de recuperación de contraseña -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.ForgotPasswordActivity">
    <!-- Creamos el círculo decorativo superior derecho -->
    <View
        android:id="@+id/decor_circle_top"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/circle_accent_top"
        android:alpha="0.18"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- Creamos el círculo decorativo inferior izquierdo -->
    <View
        android:id="@+id/decor_circle_bottom"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/circle_accent_bottom"
        android:alpha="0.12"
        android:layout_marginBottom="-40dp"
        android:layout_marginStart="-40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <!-- Creamos el ícono de la app -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_leaf"
        android:contentDescription="@string/app_name"
        app:tint="@color/accent"
        android:layout_marginStart="36dp"
        android:layout_marginTop="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <!-- Creamos el nombre de la app -->
    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:fontFamily="@font/playfair_display_bold"
        android:textSize="28sp"
        android:letterSpacing="-0.02"
        android:textColor="@color/text_primary"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/iv_logo"
        app:layout_constraintStart_toStartOf="@id/iv_logo"/>
    <!-- Creamos el tagline -->
    <TextView
        android:id="@+id/tv_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_tagline"
        android:fontFamily="@font/dm_sans"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_app_name"
        app:layout_constraintStart_toStartOf="@id/tv_app_name"/>
    <!-- Creamos el 'card' principal con el formulario -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_forgot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card_background"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_tagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Creamos el título dentro de la card -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_title"
                android:fontFamily="@font/playfair_display_semibold"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>

            <!-- Creamos la descripción del proceso -->
            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/forgot_subtitle"
                android:fontFamily="@font/dm_sans"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="24dp"/>

            <!-- Creamos el label de 'correo' -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_email"
                android:fontFamily="@font/dm_sans_medium"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp"/>

            <!-- Creamos el campo de 'correo' -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="@color/input_stroke_selector"
                app:boxStrokeWidth="1.5dp"
                app:boxBackgroundColor="@color/input_background"
                app:hintEnabled="false"
                android:layout_marginBottom="28dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_correo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:inputType="textEmailAddress"
                    android:hint="@string/hint_email"
                    android:fontFamily="@font/dm_sans"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@android:color/transparent"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Creamos el botón principal -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_send_link"
                android:fontFamily="@font/dm_sans_semibold"
                android:textSize="15sp"
                android:letterSpacing="0.04"
                android:textColor="@color/on_accent"
                app:backgroundTint="@color/accent"
                app:cornerRadius="14dp"
                app:elevation="0dp"
                app:rippleColor="@color/accent_ripple"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Creamos el 'link' de regreso al login -->
    <TextView
        android:id="@+id/tv_back_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_back_login"
        android:fontFamily="@font/dm_sans_semibold"
        android:textSize="14sp"
        android:textColor="@color/accent"
        android:layout_marginBottom="36dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
