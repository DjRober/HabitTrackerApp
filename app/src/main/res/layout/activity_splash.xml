<?xml version="1.0" encoding="utf-8"?>
<!-- Creamos el layout de la pantalla de bienvenida (splash) -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Creamos el círculo decorativo superior derecho -->
    <View
        android:id="@+id/circleTop"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/circle_accent_top"
        android:alpha="0.18"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Creamos el círculo decorativo inferior izquierdo -->
    <View
        android:id="@+id/circleBottom"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/circle_accent_bottom"
        android:alpha="0.12"
        android:layout_marginBottom="-60dp"
        android:layout_marginStart="-60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Creamos 'logo + nombre + tagline' (contenedor central) -->
    <LinearLayout
        android:id="@+id/layoutCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Creamos el ícono de la app -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_leaf"
            android:contentDescription="@string/app_name"
            app:tint="@color/accent"
            android:alpha="0"
            android:layout_marginBottom="16dp"/>

        <!-- Creamos el nombre de la app -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:fontFamily="@font/playfair_display_bold"
            android:textSize="48sp"
            android:letterSpacing="-0.02"
            android:textColor="@color/text_primary"
            android:alpha="0"
            android:layout_marginBottom="8dp"/>

        <!-- Creamos el tagline -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_tagline"
            android:fontFamily="@font/dm_sans"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:alpha="0"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
