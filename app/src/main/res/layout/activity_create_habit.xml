<?xml version="1.0" encoding="utf-8"?>
<!-- Creamos el layout de la pantalla para crear un hábito nuevo -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.CreateHabitActivity">
    <!-- Creamos el círculo decorativo superior derecho -->
    <View
        android:id="@+id/circleTop"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/circle_accent_top"
        android:alpha="0.18"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- Creamos el círculo decorativo inferior izquierdo -->
    <View
        android:id="@+id/circleBottom"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/circle_accent_bottom"
        android:alpha="0.12"
        android:layout_marginBottom="-40dp"
        android:layout_marginStart="-40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <!-- Creamos el título de la pantalla -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/create_habit_title"
        android:fontFamily="@font/playfair_display_bold"
        android:textSize="28sp"
        android:letterSpacing="-0.02"
        android:textColor="@color/text_primary"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <!-- Creamos el 'scroll' para el formulario completo -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toTopOf="@id/btnSave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <!-- Creamos la 'card' principal con el formulario -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <!-- Creamos el nombre del hábito (label) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_habit_name"
                        android:fontFamily="@font/dm_sans_medium"
                        android:textSize="12sp"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="8dp"/>

                    <!-- Creamos el nombre del hábito (campo) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilHabitName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:boxStrokeWidth="1.5dp"
                        app:boxBackgroundColor="@color/input_background"
                        app:hintEnabled="false"
                        android:layout_marginBottom="24dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtHabitName"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:inputType="textCapSentences"
                            android:hint="@string/hint_habit_name"
                            android:fontFamily="@font/dm_sans"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="@android:color/transparent"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Creamos la sección de 'frecuencia' (label) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_frequency"
                        android:fontFamily="@font/dm_sans_medium"
                        android:textSize="12sp"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="12dp"/>

                    <!-- Creamos la sección de los dos chips tipo toggle (selector de frecuencia) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="24dp">

                        <!-- Creamos la sección de 'todos los días' (opción) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFreqDaily"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="68dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/frequency_daily"
                            android:fontFamily="@font/dm_sans_medium"
                            android:textSize="13sp"
                            android:textColor="@color/on_accent"
                            app:backgroundTint="@color/accent"
                            app:strokeColor="@color/accent"
                            app:strokeWidth="1.5dp"
                            app:cornerRadius="12dp"/>

                        <!-- Creamos la sección de días específicos (opción) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFreqCustom"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="68dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/frequency_custom"
                            android:fontFamily="@font/dm_sans_medium"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            app:backgroundTint="@android:color/transparent"
                            app:strokeColor="@color/divider_color"
                            app:strokeWidth="1.5dp"
                            app:cornerRadius="12dp"/>
                    </LinearLayout>

                    <!-- Creamos la sección de 'días' cuando se activa 'días específicos' -->
                    <LinearLayout
                        android:id="@+id/layoutDays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Creamos la sección de días (opción) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_days"
                            android:fontFamily="@font/dm_sans_medium"
                            android:textSize="12sp"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="12dp"/>

                        <!-- Creamos los días de la semana como chips circulares -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="7"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:id="@+id/chipLun"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="L"
                                android:fontFamily="@font/dm_sans_medium"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:background="@drawable/bg_chip_day_unselected"
                                android:layout_marginHorizontal="3dp"
                                android:clickable="true"
                                android:focusable="true"/>

                            <TextView
                                android:id="@+id/chipMar"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="M"
                                android:fontFamily="@font/dm_sans_medium"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:background="@drawable/bg_chip_day_unselected"
                                android:layout_marginHorizontal="3dp"
                                android:clickable="true"
                                android:focusable="true"/>

                            <TextView
                                android:id="@+id/chipMie"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="X"
                                android:fontFamily="@font/dm_sans_medium"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:background="@drawable/bg_chip_day_unselected"
                                android:layout_marginHorizontal="3dp"
                                android:clickable="true"
                                android:focusable="true"/>

                            <TextView
                                android:id="@+id/chipJue"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="J"
                                android:fontFamily="@font/dm_sans_medium"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:background="@drawable/bg_chip_day_unselected"
                                android:layout_marginHorizontal="3dp"
                                android:clickable="true"
                                android:focusable="true"/>

                            <TextView
                                android:id="@+id/chipVie"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="V"
                                android:fontFamily="@font/dm_sans_medium"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:background="@drawable/bg_chip_day_unselected"
                                android:layout_marginHorizontal="3dp"
                                android:clickable="true"
                                android:focusable="true"/>

                            <TextView
                                android:id="@+id/chipSab"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="S"
                                android:fontFamily="@font/dm_sans_medium"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:background="@drawable/bg_chip_day_unselected"
                                android:layout_marginHorizontal="3dp"
                                android:clickable="true"
                                android:focusable="true"/>

                            <TextView
                                android:id="@+id/chipDom"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="D"
                                android:fontFamily="@font/dm_sans_medium"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:background="@drawable/bg_chip_day_unselected"
                                android:layout_marginHorizontal="3dp"
                                android:clickable="true"
                                android:focusable="true"/>

                        </LinearLayout>

                        <!-- Creamos la sección de 'mensaje de error' para días -->
                        <TextView
                            android:id="@+id/tvDaysError"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/error_no_days_selected"
                            android:fontFamily="@font/dm_sans"
                            android:textSize="12sp"
                            android:textColor="#B00020"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone"/>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- Creamos el botón 'guardar' anclado al fondo -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="36dp"
        android:text="@string/btn_save_habit"
        android:fontFamily="@font/dm_sans_semibold"
        android:textSize="15sp"
        android:letterSpacing="0.04"
        android:textColor="@color/on_accent"
        app:backgroundTint="@color/accent"
        app:cornerRadius="14dp"
        app:elevation="0dp"
        app:rippleColor="@color/accent_ripple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
